{
  "name": "fizzdoc",
  "version": "1.0.0",
  "private": true,
  "description": "Free, open-source iLovePDF alternative: 44 PDF, Word, Excel and image tools (edit, compress, merge, convert, OCR) that run 100% in your browser. No uploads.",
  "keywords": [
    "pdf",
    "pdf-tools",
    "pdf-editor",
    "merge-pdf",
    "compress-pdf",
    "pdf-to-word",
    "ocr",
    "privacy",
    "webassembly",
    "client-side",
    "ilovepdf-alternative",
    "smallpdf-alternative",
    "document-converter",
    "qpdf",
    "pdfjs",
    "tesseract",
    "image-compression",
    "i18n"
  ],
  "homepage": "https://fizzdoc.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/kingrishabdugar/fizzdoc.git"
  },
  "bugs": {
    "url": "https://github.com/kingrishabdugar/fizzdoc/issues"
  },
  "author": "Rishab Dugar (https://rishabdugarjain.in)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit && vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@neslinesli93/qpdf-wasm": "0.3.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
