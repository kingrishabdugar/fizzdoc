# Cloudflare Pages / Netlify response headers. The page's own CSP lives in a <meta> tag
# so it travels with the HTML to any host; frame-ancestors only works as a header.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# AI models and their engines keep the same URL between releases (the workers version their own
# Cache Storage instead), so cache them for a day and refresh in the background, not forever.
/bg/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/whisper/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/ocr/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The service worker doesn't follow the page's CSP, so it gets its own: it may only fetch from this site.
/sw.js
  Content-Security-Policy: default-src 'none'; connect-src 'self'

# The fizzdoc.pages.dev address and its preview builds are copies of fizzdoc.com; keep them out
# of search results so fizzdoc.com gets all the credit.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
