  "bin": {
    "fizzdoc-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pdf",
    "merge-pdf",
