    "mp3",
    "audio",
    "privacy",
    "claude",
    "codex"
  ],
  "homepage": "https://github.com/kingrishabdugar/fizzdoc/tree/main/mcp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/kingrishabdugar/fizzdoc.git",
    "directory": "mcp"
  },
  "author": "Rishab Dugar",
  "license": "Apache-2.0",
  "scripts": {
    "build": "vite build -c vite.config.ts",
    "prepack": "npm run build && cp ../LICENSE ../NOTICE ."
